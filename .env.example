# Chep file nay thanh .env (cung thu muc) roi dien mat khau cua ban.
# .env KHONG duoc commit (da co trong .gitignore).
# Mat khau: chi dung chu, so va dau gach duoi, toi thieu 8 ky tu
# (khong dung dau nhay kep, dau cach hay ky tu &).

# Ten container Docker va PDB (giu nguyen neu tao container theo README)
ORACLE_CONTAINER=oracle23ai
ORACLE_PDB=FREEPDB1

# Chu schema chua toan bo bang, package, view
HRM_OWNER_PASSWORD=
# Tai khoan ky thuat ma web API dung de ket noi
HRM_APP_PASSWORD=
# Mat khau chung cua 11 user Oracle demo U_* va cua moi tai khoan demo tren web
DEMO_USER_PASSWORD=
# Mat khau nen file CSV xuat ra (scripts/xuat_csv.sh --nen). De trong thi script tu sinh.
CSV_ZIP_PASSWORD=

# Tuy chon cho web API
# WEB_JWT_SECRET=      # thieu thi sinh ngau nhien moi lan khoi dong (moi nguoi phai dang nhap lai)
# ORACLE_DSN=localhost:1521/FREEPDB1
# WEB_POOL_MAX=8
